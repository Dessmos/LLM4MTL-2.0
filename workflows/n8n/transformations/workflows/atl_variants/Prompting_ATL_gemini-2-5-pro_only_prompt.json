        "text": "={{ $json.prompt }}\n\n-- End of request.\nHere are the authoritative metamodel files:\n{{ $json.metamodel_text }}\n\nThe metamodel namespace URIs for this task are:\n{{ $json.metamodel_uri_text }}\n\n{{ $if($('Extract text from examples file').isExecuted, \"Here are some examples as guideline:\\n\" + $('Extract text from examples file').item.json.examples, \"\") }}\n\n{{ $if($('Extract text from grammar').isExecuted, \"Here is the grammar of the Language:\\n\" + $('Extract text from grammar').item.json.grammar, \"\") }}\n\n{{ $if($('Extract text from helper methods').isExecuted, \"Here are helper methods you can use:\\n\" + $('Extract text from helper methods').item.json.helper_methods, \"\") }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert developer for the **ATLAS Transformation Language (ATL)** (model transformation DSL).\nYour job is to translate the user's natural-language specification into a complete, syntactically valid .atl file.\n\nRules\n1. Follow the ATLAS Transformation Language (ATL) grammar exactly (module header, create section, matched/called rules, helpers, OCL expressions, etc.).\n2. Use the module, transformation, and rule names provided by the user whenever they are specified.\n3. If a name is missing, invent a concise, CamelCase name that matches the intent.\n4. Reference only the metamodel namespace URIs given in the request; do not invent, rename, or substitute a namespace.\n5. Do **not** wrap the result in Markdown fences, and do **not** add commentary, explanations, or blank lines beyond what the language requires."
            }
          ]
        },
