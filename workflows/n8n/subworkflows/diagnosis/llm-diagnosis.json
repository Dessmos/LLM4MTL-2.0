      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst requiredString = (value, name) => {\n  if (typeof value !== 'string' || value.trim() === '') {\n    throw new Error(`Missing required string: ${name}`);\n  }\n  return value.trim();\n};\n\nconst requireTrue = (value, name) => {\n  if (value !== true) {\n    throw new Error(`${name} must be true before semantic-failure diagnosis`);\n  }\n};\n\nconst requireFalse = (value, name) => {\n  if (value !== false) {\n    throw new Error(`${name} must be false before semantic-failure diagnosis`);\n  }\n};\n\nconst runId = requiredString(input.run_id, 'run_id');\nconst language = requiredString(input.language, 'language').toLowerCase();\nconst task = requiredString(input.task, 'task');\nconst providerAlias = requiredString(input.diagnosis_provider ?? input.provider, 'diagnosis_provider').toLowerCase();\nconst provider = providerAlias === 'gemini' ? 'google' : providerAlias;\n\nif (!['openai', 'anthropic', 'google'].includes(provider)) {\n  throw new Error(`Unsupported diagnosis_provider: ${provider}`);\n}\n\nconst prechecks = input.prechecks ?? {};\nrequireTrue(prechecks.transformation_syntax_valid, 'prechecks.transformation_syntax_valid');\nrequireTrue(prechecks.test_technical_valid, 'prechecks.test_technical_valid');\nrequireTrue(prechecks.test_reference_valid, 'prechecks.test_reference_valid');\nrequireFalse(prechecks.generated_transformation_tests_pass, 'prechecks.generated_transformation_tests_pass');\n\nconst transformation = input.transformation ?? {};\nconst testSuite = input.test_suite ?? {};\nconst execution = input.execution ?? {};\n\nrequiredString(transformation.code, 'transformation.code');\nif (testSuite.semantic_cases == null && testSuite.java_sources == null) {\n  throw new Error('At least one of test_suite.semantic_cases or test_suite.java_sources is required');\n}\nif (execution.maven_output == null && execution.error_summary == null && execution.surefire_reports == null) {\n  throw new Error('Execution failure evidence is required');\n}\n\nconst evidenceRef = typeof input.evidence_ref === 'string' && input.evidence_ref.trim()\n  ? input.evidence_ref.trim()\n  : `runs/${runId}/stages/execution/latest.json`;\n\nconst evidence = {\n  run_id: runId,\n  language,\n  task,\n  premise: {\n    transformation_syntax_valid: true,\n    test_technical_valid: true,\n    test_reference_valid: true,\n    generated_transformation_tests_pass: false\n  },\n  task_contract: input.task_contract ?? null,\n  metamodel_context: input.metamodel_context ?? null,\n  reference_transformation: input.reference_transformation ?? null,\n  transformation,\n  test_suite: testSuite,\n  reference_validation: input.reference_validation ?? null,\n  execution\n};\n\nconst promptAssetRaw = requiredString(input.diagnosis_prompt_asset, \"diagnosis_prompt_asset\");\nlet promptAsset;\ntry {\n  promptAsset = JSON.parse(promptAssetRaw);\n} catch (error) {\n  throw new Error(`Invalid diagnosis prompt asset JSON: ${error.message}`);\n}\n\nconst systemPrompt = requiredString(promptAsset.system_prompt, \"prompt_asset.system_prompt\");\nconst userPromptTemplate = requiredString(promptAsset.user_prompt_template, \"prompt_asset.user_prompt_template\");\nconst evidencePlaceholder = \"{{EVIDENCE_BUNDLE_JSON}}\";\nif (!userPromptTemplate.includes(evidencePlaceholder)) {\n  throw new Error(`Diagnosis prompt asset must contain ${evidencePlaceholder}`);\n}\nconst userPrompt = userPromptTemplate.replace(evidencePlaceholder, JSON.stringify(evidence, null, 2));\n\nreturn [{\n  json: {\n    run_id: runId,\n    language,\n    task,\n    provider,\n    evidence_ref: evidenceRef,\n    evidence,\n    system_prompt: systemPrompt,\n    user_prompt: userPrompt\n  }\n}];"
      },
