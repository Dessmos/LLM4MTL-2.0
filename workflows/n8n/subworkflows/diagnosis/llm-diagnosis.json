    {
      "parameters": {
        "jsCode": "const source = $input.first().json;\nconst context = $('Validate and Build Evidence').item.json;\n\nconst candidates = [\n  source.text,\n  source.content,\n  source.output,\n  source.response,\n  source.message?.content,\n  source.choices?.[0]?.message?.content\n];\nconst raw = candidates.find((value) => typeof value === 'string' && value.trim() !== '');\nif (!raw) {\n  throw new Error('Diagnosis LLM returned no textual response');\n}\n\nlet cleaned = raw.trim();\ncleaned = cleaned.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\nconst firstBrace = cleaned.indexOf('{');\nconst lastBrace = cleaned.lastIndexOf('}');\nif (firstBrace < 0 || lastBrace <= firstBrace) {\n  throw new Error(`Diagnosis LLM did not return a JSON object: ${cleaned.slice(0, 300)}`);\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned.slice(firstBrace, lastBrace + 1));\n} catch (error) {\n  throw new Error(`Invalid diagnosis JSON: ${error.message}`);\n}\n\nconst classification = String(parsed.classification ?? '').trim().toUpperCase();\nconst allowed = new Set(['TRANSFORMATION_DEFECT', 'TEST_DEFECT', 'AMBIGUOUS']);\nif (!allowed.has(classification)) {\n  throw new Error(`Invalid diagnosis classification: ${classification || '<empty>'}`);\n}\n\nconst rationale = String(parsed.rationale ?? '').trim();\nif (!rationale) {\n  throw new Error('Diagnosis rationale is required');\n}\n\nreturn [{\n  json: {\n    schema_version: '1.0',\n    classification,\n    evidence_ref: context.evidence_ref,\n    rationale,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
