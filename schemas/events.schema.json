{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm4mtl/schemas/events.schema.json",
  "title": "Run event",
  "description": "One line of the append-only events.jsonl run timeline. The events log is the source of truth for run history; full per-attempt evidence lives in stages/<stage>/attempts/. Run-scoped events (run_created, run_resumed, run_finished) carry no `stage`; stage-scoped events always do. `status` uses the stage vocabulary and `run_status` the run vocabulary; they are never interchangeable.",
  "type": "object",
  "required": [
    "schema_version",
    "ts",
    "event"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "type": "string",
      "description": "Contract stage id; absent for run-scoped events."
    },
    "event": {
      "type": "string",
      "enum": [
        "run_created",
        "run_resumed",
        "run_finished",
        "stage_started",
        "stage_finished",
        "stage_skipped_resume",
        "diagnosis_recorded"
      ]
    },
    "outcome_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "passed",
        "failed",
        "skipped",
        "infrastructure_error",
        null
      ]
    },
    "run_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "completed",
        "completed_with_failures",
        "incomplete",
        "failed",
        "dry_run",
        null
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    }
  }
}
