{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm4mtl/schemas/contract.schema.json",
  "title": "Task model contract",
  "description": "Deterministic structural ground truth for one transformation task. The camelCase representation is the currently persisted benchmark format and is identical for every language: an ETL contract carries the same identity, provenance, and model fields an ATL, QVT-O, or Reactions contract carries. The snake_case representation remains accepted for compatibility with the originally published schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/currentContract"
    },
    {
      "$ref": "#/$defs/schemaCompatibilityContract"
    }
  ],
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "source",
        "target",
        "inout"
      ]
    },
    "currentModel": {
      "type": "object",
      "required": [
        "runtimeName",
        "roles",
        "kind",
        "metamodelAlias",
        "typesUsedInTransformation",
        "availableTypes"
      ],
      "additionalProperties": false,
      "properties": {
        "runtimeName": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "emf",
            "plainXml"
          ]
        },
        "metamodelUri": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodelNsPrefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodelAlias": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodelFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "typesUsedInTransformation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availableTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "currentContract": {
      "type": "object",
      "required": [
        "schemaVersion",
        "task",
        "language",
        "transformation",
        "reference",
        "sourceHash",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "enum": [
            "etl",
            "atl",
            "qvto",
            "reactions"
          ]
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/currentModel"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisiteTasks": {
          "description": "Tasks whose transformation must run alongside this one for this task's own transformation to have anything to match against. A Reactions task that retrieves a correspondence needs the task that establishes it; without it even the reference transformation produces nothing, so the task cannot be validated in isolation. Direct prerequisites only -- they are resolved transitively.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "schemaCompatibilityModel": {
      "type": "object",
      "required": [
        "runtime_name",
        "roles",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "emf",
            "plainXml"
          ]
        },
        "metamodel_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodel_ns_prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodel_alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "metamodel_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "types_used_in_etl": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "types_used_in_transformation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "available_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "schemaCompatibilityContract": {
      "type": "object",
      "required": [
        "schema_version",
        "task",
        "source_hash",
        "models"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string"
        },
        "source_hash": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/schemaCompatibilityModel"
          }
        }
      }
    }
  }
}
